diff -ruN --strip-trailing-cr a/public/css/style.css b/public/css/style.css
--- a/public/css/style.css	2026-10-26 19:51:46.675889602 +0000
+++ b/public/css/style.css	2026-10-26 19:51:46.677487334 +0000
@@ -1227,3 +1227,11 @@
 #plan-body.pl-step-anim > .pl-task-focus { animation: pl-focus-pop .5s cubic-bezier(.2, .9, .3, 1.15) backwards .05s; }
 @keyframes pl-focus-pop { from { opacity: 0; transform: translateY(24px) scale(.94); } }
 @media (prefers-reduced-motion: reduce) { #plan-body.pl-step-anim > .pl-task-focus { animation: none; } .pl-focus-input { transition: none; } }
+
+/* پنل افزودنِ مجزا از تسک‌های ثبت‌شده‌ی همان روز */
+.day-add-panel { display: flex; flex-direction: column; gap: 6px; padding: var(--space-3); border: 1.5px dashed color-mix(in srgb, var(--pl-c, var(--plan-title)) 70%, var(--plan-field-border)); border-radius: 14px; background: color-mix(in srgb, var(--pl-c, var(--plan-title)) 10%, var(--plan-card)); }
+.day-add-label { font-size: var(--fs-xs); font-weight: 800; color: var(--plan-title); }
+.day-card .day-add-panel .day-add-input { border-style: solid; }
+.pl-day.day-card > .day-list-head { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-4); font-size: var(--fs-xs); font-weight: 800; color: var(--plan-hint); }
+.day-list-head::after { content: ""; flex: 1; border-block-start: 1px dashed var(--plan-line); }
+.day-list-count { min-width: 22px; padding: 0 7px; border-radius: 999px; background: rgba(10, 107, 75, 0.14); color: var(--plan-title); text-align: center; }
