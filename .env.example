# کپی این فایل به .env و مقادیر را مطابق سرور تنظیم کنید

# پورت داخلی سرویس بک‌اند (پشت این پورت، دامنه attendance.farazhonar.com در فاز ۴ قرار می‌گیرد)
PORT=3000

# مسیر فایل دیتابیس SQLite
DB_PATH=./data/attendance.db

# محیط اجرا
NODE_ENV=production

# رنج شبکه داخلی مجاز شرکت (فاز ۲ - middleware محدودسازی IP)
ALLOWED_NETWORK_CIDR=192.168.10.0/24

# آیا این برنامه پشت یک ریورس‌پراکسی (مثلاً IIS یا nginx) روی همان سرور اجرا می‌شود؟
# اگر بله: true بگذارید تا Express به هدر X-Forwarded-For اعتماد کند.
# اگر خیر (Node مستقیماً درخواست‌ها را می‌گیرد): false بگذارید (پیش‌فرض امن‌تر).
# نکته امنیتی مهم: تنظیم اشتباه این مقدار روی true بدون وجود پراکسی واقعی،
# به هر کلاینتی اجازه می‌دهد با ارسال هدر جعلی X-Forwarded-For از چک IP فاز ۲ عبور کند.
TRUST_PROXY=false

# ===== فاز ۳: بات تلگرام =====

# توکن بات را از @BotFather در تلگرام بگیرید (دستور /newbot)
TELEGRAM_BOT_TOKEN=

# آدرس عمومی Mini App (فاز ۴). تا وقتی ساخته نشده، خالی بگذارید تا دکمه منو تنظیم نشود.
MINI_APP_URL=

# ساعت شروع/پایان رسمی کاری شرکت (HH:mm، بر اساس ساعت سرور)
WORK_DAY_START=08:00
WORK_DAY_END=16:30

# چند دقیقه بعد از WORK_DAY_START مهلت داده شود قبل از یادآوری تأخیر
LATE_CHECKIN_GRACE_MINUTES=15

# چند دقیقه قبل از WORK_DAY_END یادآوری ثبت خروج ارسال شود
CHECKOUT_REMINDER_MINUTES_BEFORE=15

# بعد از چند بار تأخیر در ۳۰ روز اخیر، به مدیر مستقیم هشداده داده شود
REPEATED_LATENESS_THRESHOLD=3

# عبارات Cron (فرمت node-cron). پیش‌فرض‌ها برای روزهای کاری شنبه تا چهارشنبه تنظیم شده‌اند
# (کدهای روز هفته در node-cron: 0=یکشنبه ... 6=شنبه) — ⚠️ حتماً متناسب با روزهای کاری واقعی شرکت اصلاح کنید.
CRON_LATE_CHECKIN_CHECK=*/5 8-12 * * 6,0,1,2,3
CRON_CHECKOUT_REMINDER_CHECK=*/5 15-18 * * 6,0,1,2,3
CRON_DAILY_REPORT=0 17 * * 6,0,1,2,3
CRON_WEEKLY_REPORT=0 8 * * 6
# ⚠️ این Job هر روز در ساعت زیر اجرا می‌شود ولی فقط در روز اول ماه شمسی واقعاً گزارش ماه گذشته را می‌فرستد
# (چون شروع ماه شمسی روی تقویم میلادی ثابت نیست و نمی‌شود آن را مستقیماً با cron میلادی مشخص کرد).
CRON_MONTHLY_REPORT=0 8 * * *
CRON_AUTO_CLOSE_INCOMPLETE=59 23 * * *
