# کپی این فایل به .env و مقادیر را مطابق سرور تنظیم کنید

# پورت داخلی سرویس بک‌اند (پشت این پورت، دامنه attendance.farazhonar.com در فاز ۴ قرار می‌گیرد)
PORT=3000

# مسیر فایل دیتابیس SQLite
DB_PATH=./data/attendance.db

# محیط اجرا
NODE_ENV=production

# رنج شبکه داخلی مجاز شرکت (فاز ۲ - middleware محدودسازی IP)
ALLOWED_NETWORK_CIDR=192.168.10.0/24

# آیا این برنامه پشت یک ریورس‌پراکسی (مثلاً IIS یا nginx) روی همان سرور اجرا می‌شود؟
# اگر بله: true بگذارید تا Express به هدر X-Forwarded-For اعتماد کند.
# اگر خیر (Node مستقیماً درخواست‌ها را می‌گیرد): false بگذارید (پیش‌فرض امن‌تر).
# نکته امنیتی مهم: تنظیم اشتباه این مقدار روی true بدون وجود پراکسی واقعی،
# به هر کلاینتی اجازه می‌دهد با ارسال هدر جعلی X-Forwarded-For از چک IP فاز ۲ عبور کند.
TRUST_PROXY=false
