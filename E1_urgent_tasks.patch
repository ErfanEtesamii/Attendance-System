+      rescheduleTo: last && last.reschedule_to ? last.reschedule_to : null,
+      answered: logs.length > 0,
+    });
+  });
+}
+
+module.exports = { assign, remove, list, statusOf, scopeFailure, TITLE_MAX, DESC_MAX, NOTE_MAX, MAX_AHEAD_DAYS };
