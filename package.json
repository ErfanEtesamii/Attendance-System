{
  "name": "farazhonar-attendance-backend",
  "version": "1.0.0-rc.1",
  "description": "سیستم حضور و غیاب تلگرامی شرکت فرازهنر — بک‌اند Express + SQLite، بات تلگرام (polling)، Mini App کارمند و پنل مدیریتی وب (فاز ۱ تا ۹)",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/index.js",
    "start:api-only": "node src/server.js",
    "init-db": "node src/db/init.js",
    "migrate": "node src/db/migrate.js",
    "migrate:status": "node src/db/migrate.js --status",
    "test": "node scripts/run-tests.js",
    "test:watch": "node scripts/run-tests.js --watch",
    "smoke": "node scripts/smoke-test.js",
    "bench:analytics": "node scripts/bench-analytics.js",
    "create-admin": "node src/scripts/createAdmin.js",
    "dev": "node --watch src/index.js",
    "secret-scan": "node scripts/secret-scan.js",
    "package": "node scripts/package-release.js",
    "lint": "eslint src scripts test public public-admin",
    "check:contrast": "node scripts/check-contrast.js",
    "visual": "node scripts/visual-test.js",
    "check": "npm run lint && npm run check:contrast && npm test && npm run secret-scan && npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jalaali-js": "^1.2.8",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "playwright": "^1.64.1"
  }
}
